CI=false

# This branch is the first redesign (direction B as originally built). It is
# published alongside the newer light/motion design so the two can be compared:
#   /      the previous site, untouched
#   /new   the light + motion design  (branch feat/light-motion)
#   /new2  this branch
PUBLIC_URL=/new2

# Trims the source maps out of the production bundle — they are 4x the JS itself
# and expose the whole source tree to anyone who opens devtools.
GENERATE_SOURCEMAP=false
