CI=false

# The redesigned storefront is published to a sub-folder so the previous site
# can keep serving the domain root against the same dashboard. Change this to a
# single "/" on the day the new site takes over the root.
PUBLIC_URL=/new

# Trims the source maps out of the production bundle — they are 4x the JS itself
# and expose the whole source tree to anyone who opens devtools.
GENERATE_SOURCEMAP=false
